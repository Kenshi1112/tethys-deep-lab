# Copy this file to .env.local for local work. On Vercel, set these in
# Project > Settings > Environment Variables (never commit real secrets).

# Postgres connection string.
# On Vercel: adding the Neon database from the Storage tab sets this for you
# (it creates DATABASE_URL / POSTGRES_URL automatically).
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Optional. If set, the 3 POST endpoints require header "x-api-key: <this value>".
# Leave empty for demo mode (no key needed).
BOT_API_KEY=

# Optional. Set to true if Botnoi cannot read response bodies of 4xx errors:
# every response then uses HTTP 200 (the real result is still in "ok" and "code").
RESPONSE_ALWAYS_200=false
